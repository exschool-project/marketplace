# Salin file ini menjadi .env (lokal) dan isi juga di Vercel > Project Settings > Environment Variables

# Project Settings > API di dashboard Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings > API > anon public key (aman dipakai di browser, dibatasi RLS)
SUPABASE_ANON_KEY=isi-anon-key-di-sini

# Project Settings > API > service_role key
# RAHASIA — jangan pernah commit atau kirim ke browser.
# Hanya dipakai oleh fungsi di folder /api.
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-di-sini
