{
  "version": 2,
  "installCommand": "npm install && npm install --prefix server",
  "builds": [
    { "src": "client/**", "use": "@vercel/static" },
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": "server/**" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api" },
    { "src": "/", "dest": "/client/index.html" },
    { "src": "/(.*)", "dest": "/client/$1" }
  ]
}
